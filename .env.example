# Database Configuration
# For local development with SQLite (recommended for testing)
DATABASE_URL=sqlite+aiosqlite:///./book_db.sqlite

# For production with PostgreSQL (use with Docker)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/book_db

# Security Configuration
# WARNING: Generate a strong random secret key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=changethis_secret_key_for_jwt_encoding_PLEASE_CHANGE_IN_PRODUCTION

# JWT Algorithm (HS256 is standard, don't change unless you know what you're doing)
ALGORITHM=HS256

# JWT Token expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI/LLM Configuration (Optional - only needed for AI summary features)
# Get your API key from: https://console.groq.com/keys
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Application Settings
PROJECT_NAME=Book Management System
